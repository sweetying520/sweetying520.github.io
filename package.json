{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/hexo.cjs generate",
    "clean": "node tools/hexo.cjs clean",
    "deploy": "npm run verify && node tools/hexo.cjs deploy",
    "server": "node tools/hexo.cjs server --ip 127.0.0.1 --config _config.yml,_config.preview.yml",
    "check": "node tools/check-site.mjs",
    "check:source": "node tools/check-source.mjs",
    "verify": "npm run check:source && npm run clean && npm run build && npm run check",
    "prebuild": "node tools/sync-vendor.mjs",
    "preserver": "node tools/sync-vendor.mjs",
    "hexo": "node tools/hexo.cjs"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-deployer-git": "4.0.0",
    "hexo-generator-archive": "2.0.0",
    "hexo-generator-category": "2.0.0",
    "hexo-generator-index": "4.0.0",
    "hexo-generator-tag": "2.0.0",
    "hexo-renderer-ejs": "2.0.0",
    "hexo-renderer-marked": "7.0.1",
    "hexo-renderer-stylus": "3.0.1",
    "hexo-server": "3.0.0",
    "hexo-theme-fluid": "1.9.9",
    "jquery": "3.7.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
